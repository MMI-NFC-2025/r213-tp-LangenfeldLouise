---
import { getImageUrl } from "../backend.mjs";

const { record } = Astro.props;

const title =
    record?.titre ??
    record?.title ??
    record?.nom ??
    record?.name ??
    record?.nomMaison ??
    "Offre";
const description =
    record?.description ?? record?.resume ?? record?.details ?? "";
const price =
    record?.prix ??
    record?.price ??
    record?.loyer ??
    record?.montant ??
    record?.Prix ??
    null;
const surface = record?.surface ?? record?.m2 ?? null;
const city =
    record?.ville ??
    record?.city ??
    record?.localisation ??
    record?.adresse ??
    record?.Adresse ??
    "";

const imageFile =
    (Array.isArray(record?.image) ? record.image[0] : record?.image) ??
    (Array.isArray(record?.photo) ? record.photo[0] : record?.photo) ??
    (Array.isArray(record?.images) ? record.images[0] : record?.images) ??
    null;

const imageUrl = imageFile ? await getImageUrl(record, imageFile) : null;
---

<article
    class="relative bg-white border border-slate-200 rounded overflow-hidden shadow-sm"
>
    {
        imageUrl ? (
            <img
                src={imageUrl}
                alt={title}
                class="w-full h-48 object-cover"
                loading="lazy"
            />
        ) : (
            <div class="w-full h-48 bg-slate-100 flex items-center justify-center text-slate-400 text-sm">
                Pas d'image
            </div>
        )
    }
    <div class="p-4 space-y-2">
        <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
        {description && <p class="text-sm text-slate-600">{description}</p>}
        <div class="flex flex-wrap gap-2 text-sm text-slate-600">
            {
                price !== null && price !== undefined && (
                    <span class="bg-slate-100 px-2 py-1 rounded">€{price}</span>
                )
            }
            {
                surface !== null && surface !== undefined && (
                    <span class="bg-slate-100 px-2 py-1 rounded">
                        {surface} m²
                    </span>
                )
            }
            {city && <span class="bg-slate-100 px-2 py-1 rounded">{city}</span>}
        </div>
    </div>
    <a
        href={`/offres/${record.id}`}
        class="text-sm font-semibold text-blue-600 hover:text-blue-700 px-4 pb-4 block"
    >
        Voir plus
    </a>

    <button
        class="favoriteButton absolute bottom-2 left-2 w-8 h-8 rounded border-2 border-green-500 bg-white hover:bg-green-500 transition-colors duration-200 flex items-center justify-center"
        data-offre={JSON.stringify(record)}
        data-favori={record?.favori ? "true" : "false"}
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill={record?.favori ? "white" : "none"}
            stroke={record?.favori ? "white" : "#22c55e"}
            stroke-width="2"
        >
            <path
                d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z"
            ></path>
        </svg>
    </button>
</article>

<script>
    import { setFavori } from "../backend.mjs";

    const favoriteButtons = document.querySelectorAll(".favoriteButton");

    favoriteButtons.forEach((button) => {
        const htmlButton = button as HTMLButtonElement;
        const isFavori = htmlButton.dataset.favori === "true";
        if (isFavori) {
            htmlButton.classList.add("bg-green-500");
            htmlButton.classList.remove("bg-white");
            const path = htmlButton.querySelector("path");
            if (path) {
                path.setAttribute("fill", "white");
                path.setAttribute("stroke", "white");
            }
        }

        htmlButton.addEventListener("click", () => {
            const offreData = JSON.parse(htmlButton.dataset.offre || "{}");
            const newFavori = !offreData.favori;

            setFavori(offreData);

            const path = htmlButton.querySelector("path");
            if (path) {
                if (newFavori) {
                    htmlButton.classList.add("bg-green-500");
                    htmlButton.classList.remove("bg-white");
                    path.setAttribute("fill", "white");
                    path.setAttribute("stroke", "white");
                } else {
                    htmlButton.classList.remove("bg-green-500");
                    htmlButton.classList.add("bg-white");
                    path.setAttribute("fill", "none");
                    path.setAttribute("stroke", "#22c55e");
                }
            }

            offreData.favori = newFavori;
            htmlButton.dataset.offre = JSON.stringify(offreData);
            htmlButton.dataset.favori = newFavori ? "true" : "false";
        });
    });
</script>
---
import { getOffre } from "../../backend.mjs";
import Base from "../../layouts/Base.astro";

const { id } = Astro.params;
const offre = await getOffre(id);
---

<Base titre={offre ? offre.nomMaison : "Offre"}>
    <h1>Offre Item: {id}</h1>
    <h2>{offre ? offre.nomMaison : "Offre non trouvée"}</h2>
    <p>{offre ? offre.adresse : "Adresse non disponible"}</p>
    <p>{offre ? `${offre.surface} m²` : "Surface non disponible"}</p>
    <p>{offre ? `€${offre.prix}` : "Prix non disponible"}</p>
</Base>

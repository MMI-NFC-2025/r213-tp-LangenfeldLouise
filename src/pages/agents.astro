---
import Layout from "../layouts/Layout.astro";
import { getAgents } from "../backend.mjs";

const agents = await getAgents();
---

<Layout title="Liste des agents">
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-8">Nos agents immobiliers</h1>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                agents.map((agent) => (
                    <a
                        href={`/agents/${agent.id}`}
                        class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-6"
                    >
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center text-2xl font-bold text-blue-500">
                                {agent.nom?.charAt(0).toUpperCase()}
                            </div>
                            <div>
                                <h2 class="text-xl font-semibold">
                                    {agent.nom} {agent.prénom}
                                </h2>
                                <p class="text-gray-500">{agent.email}</p>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </main>
</Layout>
